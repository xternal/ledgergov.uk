{
  "name": "public-ledger",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @ledger/web dev",
    "build": "pnpm --filter @ledger/web build",
    "test": "pnpm --filter \"./packages/*\" --workspace-concurrency=1 test",
    "typecheck": "pnpm -r typecheck",
    "validate": "tsx scripts/validate.ts",
    "etl": "etl/.venv/bin/python -m etl.build",
    "contracts": "etl/.venv/bin/python -m etl.contracts",
    "backtest": "etl/.venv/bin/python -m etl.backtest",
    "constituencies": "tsx scripts/constituencies.ts",
    "journeys": "python3 scripts/journeys/build.py docs/CUSTOMER_JOURNEYS.md out/journey-maps.html",
    "deadlines": "tsx scripts/deadlines.ts",
    "review": "tsx scripts/review.ts",
    "alerts": "tsx scripts/alerts.ts",
    "indexnow": "tsx scripts/indexnow.ts",
    "harvest": "tsx scripts/harvest.ts",
    "parity:snapshot": "tsx scripts/parity.ts snapshot",
    "parity:check": "tsx scripts/parity.ts check",
    "openpromises:provenance": "tsx scripts/openpromises-provenance.ts",
    "pe:probe": "tsx scripts/pe-probe.ts",
    "household": "tsx scripts/household.ts"
  },
  "devDependencies": {
    "@ledger/engine": "workspace:*",
    "@ledger/schema": "workspace:*",
    "@openpromises/cli": "0.11.0",
    "@openpromises/core": "0.11.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
